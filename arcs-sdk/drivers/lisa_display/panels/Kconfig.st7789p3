menu "ST7789P3 Display Panel"

if LISA_DISPLAY_PANEL_ST7789P3

config PANEL_ST7789P3_WIDTH
	int "screen width"
	default 170
	help
	The pixel length in the x-axis direction of the display screen, the maximum value is 240.

config PANEL_ST7789P3_HEIGHT
	int "screen height"
	default 320
	help
	The pixel length in the y-axis direction of the display screen, the maximum value is 240.

config PANEL_ST7789P3_GRAM_HEIGHT
	int "controller gram height"
	default 320
	help
	Full frame memory rows of the controller (ST7789 is 240x320). The glass
	only covers PANEL_ST7789P3_HEIGHT rows of them, so when MADCTL MY mirrors
	the row address inside the whole gram, the window start row has to be
	shifted by (gram height - screen height).

config PANEL_ST7789P3_X_OFFSET
	int "display screen x offset"
	default 35
	help
	The pixel offset in the x-axis direction of the display screen.

config PANEL_ST7789P3_Y_OFFSET
	int "screen y offset"
	default 0
	help
	The pixel offset in the y-axis direction of the display screen.

config ROTATE_BUF_MAX_HEIGHT
	int "roate buffer buffer max height"
	default PANEL_ST7789P3_WIDTH

endif

endmenu
