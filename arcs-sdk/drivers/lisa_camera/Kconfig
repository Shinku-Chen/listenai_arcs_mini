menu "LISA Camera"
	config LISA_CAMERA_DEVICE
		bool "LISA Camera support"
		help
			Enable LISA Camera support

if LISA_CAMERA_DEVICE

config LISA_CAMERA_CPDMA_TRANSFORM
    bool "CPDMA RGB565 camera transform"
    depends on SOC_ARCS
    help
      Enable synchronous integer downsampling, 90-degree clockwise rotation
      and byte swapping with CPDMA. Temporarily reserves the configured channel.

config LISA_CAMERA_CPDMA_CH
    int "Camera transform CPDMA channel"
    depends on LISA_CAMERA_CPDMA_TRANSFORM
    range 0 3
    default 1
    help
      Select a channel owned by this core. Reservation state is local to each
      core and cannot detect channels reserved by the other core.


choice LISA_CAMERA_BUS_TYPE
	prompt "Select bus type"
	default LISA_CAMERA_BUS_SPI

	config LISA_CAMERA_BUS_SPI
		bool "SPI Bus"
		select LISA_SPI_DEVICE
		help
			Use SPI bus for camera data.

	config LISA_CAMERA_BUS_DVP
		bool "DVP Bus"
		select LISA_DVP_DEVICE
		help
			Use DVP bus for camera data.

endchoice

config LISA_CAMERA_SENSOR_BF3901
	bool "BF3901"

config LISA_CAMERA_SENSOR_GC032A
	bool "GC032A"

config LISA_CAMERA_SENSOR_GC0328
	bool "GC0328"

config LISA_CAMERA_SENSOR_SC030IOT
	bool "SC030IOT"

config LISA_CAMERA_SENSOR_TC6036
	bool "TC6036"
	help
		Enable TC6036 camera sensor support (640x480 YUV422/RGB565)

endif #LISA_CAMERA_DEVICE

endmenu
