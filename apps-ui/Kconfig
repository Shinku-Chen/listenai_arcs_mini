menu  "Application UI"

config APPLICATION_UI
    bool "application ui"
    default n

if APPLICATION_UI

config APPLICATION_UI_ASSISTANT
    bool "assistant pages (home / qrcode / settings)"
    default y
    help
      助手页面（主页、扫码配网、设置、闹钟页）与它们的 models/presenters。
      纯功能固件（如 leo-radio 网络电台）可以关掉：这些页面不会被初始化，
      也不需要 cloud / voice_intent 这些模块的头文件。

config ALARM_RING_AUTO_RETURN_MS
    int "Alarm ring UI auto return timeout (ms)"
    default 60000
    help
        Time before alarm ring page automatically returns to Home.

config TTS_TEXT_MS_PER_CHAR
    int "TTS text display time per character (ms)"
    default 250
    help
        Display duration per spoken character for TTS subtitle text.
        Can be overridden at runtime via KV key user.tts_text_ms_per_char.

endif

endmenu
